# Copy to .env and enter at least one news-provider key.
# NewsAPI/GNews supply general categories; free-plan delays and quotas may apply.
GNEWS_API_KEY=
NEWSAPI_KEY=
# Optional: financial headlines with provider-tagged tickers, plus stock quotes.
# Quote currency is unknown unless a provider supplies it; prices are never invented.
FINNHUB_API_KEY=
# Only used by the separate AI summary endpoint; not needed for /news/feed.
OPENAI_API_KEY=
REDIS_URL=redis://localhost:6379/0
DATABASE_URL=sqlite:///./hercules.db
DEBUG=false
