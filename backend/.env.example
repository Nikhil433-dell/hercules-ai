# Copy to .env and enter at least one news-provider key.
# NewsAPI/GNews supply general categories; free-plan delays and quotas may apply.
GNEWS_API_KEY=
NEWSAPI_KEY=
# Optional: financial headlines with provider-tagged tickers, plus stock quotes.
# Quote currency is unknown unless a provider supplies it; prices are never invented.
FINNHUB_API_KEY=
# Only used by the separate AI summary endpoint; not needed for /news/feed.
OPENAI_API_KEY=
# Gemini takes precedence in auto mode when a Gemini key is configured.
MARKET_ANALYSIS_PROVIDER=auto
GEMINI_API_KEY=
GEMINI_MODEL=gemini-4-carbon
# Local Ollama analysis when Gemini is not selected.
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b
REDIS_URL=redis://localhost:6379/0
DATABASE_URL=sqlite:///./hercules.db
MARKET_EVENT_HISTORY_ENABLED=true
DEBUG=false
